---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import OptionalLink from "./OptionalLink.astro";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project: { data } } = Astro.props;
---

<div class="p-2 m-4 lg:m-8 bg-black text-white">
    <h4 class="text-lg">
        <OptionalLink href={data.urls.project}>{data.name}</OptionalLink>
    </h4>
    <h5><OptionalLink href={data.urls.author}>{data.author}</OptionalLink></h5>

    <p class="py-1">{data.description}</p>

    {data.imageUrl && (
        <div class="grayscale pt-3">
            <Image width={500} height={500} src={data.imageUrl} alt={data.name} />
        </div>
    )}
</div>
