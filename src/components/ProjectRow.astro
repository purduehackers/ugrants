---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";

interface Props {
    project: CollectionEntry<"projects">;
    img: ImageMetadata | undefined;
    index: number;
}

const {
    project: { data },
    img,
    index,
} = Astro.props;

const src = img ?? data.imageUrl;
---

<div
    class="reveal-row enter -mx-3 grid min-h-[40px] items-center gap-x-4 border-b border-hairline px-3 py-2.5 transition-colors duration-150 ease-quint hover:bg-ink/[0.03] sm:grid-cols-[minmax(0,1fr)_auto]"
    style={`--i: ${Math.min(index, 10) + 6}`}
>
    <span class="truncate text-[14px] leading-[1.35]">
        <OptionalLink href={data.urls.project}>{data.name}</OptionalLink>
    </span>
    <span class="truncate text-[13px] leading-[1.35] text-muted sm:text-right">
        <Authors authors={data.authors} />
    </span>

    <div class="reveal-card">
        <div class="card-frame border border-hairline">
            {
                src ? (
                    <Image
                        class="w-[var(--tile)]"
                        src={src}
                        width={232}
                        height={232}
                        fit="cover"
                        alt=""
                        loading="eager"
                        fetchpriority="low"
                    />
                ) : (
                    <div class="dither-field aspect-square w-[var(--tile)]" />
                )
            }
        </div>
        <p class="card-text text-[13px] leading-[1.4] text-ink">
            {data.description}
        </p>
    </div>
</div>

<style>
    .reveal-row {
        position: relative;
    }

    /* Fixed and pinned to the pointer, placed once on enter so it does not
       slide around while it is being read. */
    .reveal-card {
        position: fixed;
        top: var(--card-y, 0);
        left: var(--card-x, 0);
        z-index: 20;
        display: flex;
        width: calc(var(--tile) + 32px);
        flex-direction: column;
        gap: 10px;
        padding: 16px;
        background: var(--color-page);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-chip);
        box-shadow: 0 8px 28px rgb(10 10 10 / 0.1);
        opacity: 0;
        transform: scale(0.97);
        transform-origin: top left;
        pointer-events: none;

        --dur: 200ms;
        --beat: 55ms;

        /* Exit faster than enter: the user has already moved on. */
        transition:
            opacity 120ms var(--ease-quint),
            transform 120ms var(--ease-quint);
    }

    .card-frame {
        flex: none;
    }

    /* No reveal of its own: anything directional on a photo reads as a
       progressive download rather than as intent. */
    .card-text {
        opacity: 0;
        transform: translateY(4px);
        transition:
            opacity 120ms var(--ease-quint),
            transform 120ms var(--ease-quint);
    }

    /* Second card onward in a sweep runs at about half the time. */
    :global([data-warm]) .reveal-card {
        --dur: 110ms;
        --beat: 25ms;
    }

    .reveal-row:is(:hover, :has(:focus-visible)) .reveal-card {
        opacity: 1;
        transform: scale(1);
        transition-duration: var(--dur);
    }

    .reveal-row:is(:hover, :has(:focus-visible)) .card-text {
        opacity: 1;
        transform: translateY(0);
        transition-duration: var(--dur);
        transition-delay: var(--beat);
    }

    /* Nothing to hover, so the description is simply part of the row. */
    @media (hover: none) {
        .reveal-card {
            position: static;
            grid-column: 1 / -1;
            width: auto;
            padding: 6px 0 0;
            border: 0;
            background: none;
            box-shadow: none;
            opacity: 1;
            transform: none;
            pointer-events: auto;
        }

        .card-frame {
            display: none;
        }

        .card-text {
            opacity: 1;
            transform: none;
            color: var(--color-muted);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal-card,
        .reveal-row:is(:hover, :has(:focus-visible)) .reveal-card {
            transform: none;
            transition: opacity 120ms linear;
        }

        .card-text,
        .reveal-row:is(:hover, :has(:focus-visible)) .card-text {
            transform: none;
            transition: opacity 120ms linear;
            transition-delay: 0ms;
        }
    }
</style>

<script>
    const list = document.querySelector<HTMLElement>("[data-view-list]");

    if (list) {
        const PAD = 16;
        const OFFSET = 18;
        let cool: ReturnType<typeof setTimeout>;

        function place(row: HTMLElement, x: number, y: number) {
            const card = row.querySelector<HTMLElement>(".reveal-card");
            if (!card) return;

            const w = card.offsetWidth;
            const h = card.offsetHeight;

            // Prefer down-right of the pointer, flip left when it would run
            // off the edge, then clamp both axes into the viewport.
            let left = x + OFFSET;
            if (left + w + PAD > innerWidth) left = x - OFFSET - w;
            left = Math.max(PAD, Math.min(left, innerWidth - w - PAD));

            const top = Math.max(
                PAD,
                Math.min(y + OFFSET, innerHeight - h - PAD),
            );

            card.style.setProperty("--card-x", `${left}px`);
            card.style.setProperty("--card-y", `${top}px`);
        }

        function open(row: HTMLElement, x: number, y: number) {
            clearTimeout(cool);
            place(row, x, y);
            list!.setAttribute("data-warm", "");
        }

        for (const row of list.querySelectorAll<HTMLElement>(".reveal-row")) {
            row.addEventListener("pointerenter", (e) =>
                open(row, e.clientX, e.clientY),
            );
            // Keyboard focus has no pointer, so anchor to the row itself.
            row.addEventListener("focusin", () => {
                const r = row.getBoundingClientRect();
                open(row, r.left + 24, r.bottom);
            });
        }

        list.addEventListener("pointerleave", () => {
            cool = setTimeout(() => list.removeAttribute("data-warm"), 400);
        });
    }
</script>
