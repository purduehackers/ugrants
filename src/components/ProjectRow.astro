---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";

interface Props {
    project: CollectionEntry<"projects">;
    img: ImageMetadata | undefined;
    index: number;
}

const {
    project: { data },
    img,
    index,
} = Astro.props;

const src = img ?? data.imageUrl;
---

<div
    class="reveal-row enter -mx-3 grid min-h-[40px] items-center gap-x-4 border-b border-hairline px-3 py-2.5 transition-colors duration-150 ease-quint hover:bg-ink/[0.03] sm:grid-cols-[minmax(0,1fr)_auto]"
    style={`--i: ${Math.min(index, 10) + 6}`}
>
    <span class="truncate text-[14px] leading-[1.35]">
        <OptionalLink href={data.urls.project}>{data.name}</OptionalLink>
    </span>
    <span class="truncate text-[13px] leading-[1.35] text-muted sm:text-right">
        <Authors authors={data.authors} />
    </span>

    <div class="reveal-card">
        <div class="card-frame border border-hairline">
            {
                src ? (
                    <Image
                        class="w-[var(--tile)]"
                        src={src}
                        width={232}
                        height={232}
                        fit="cover"
                        alt=""
                        loading="eager"
                        fetchpriority="low"
                    />
                ) : (
                    <div class="dither-field aspect-square w-[var(--tile)]" />
                )
            }
        </div>
        <p class="card-text text-[13px] leading-[1.4] text-ink">
            {data.description}
        </p>
    </div>
</div>

<style>
    .reveal-row {
        position: relative;
    }

    .reveal-card {
        position: absolute;
        top: var(--card-top, -8px);
        left: calc(100% + 20px);
        z-index: 20;
        display: flex;
        width: calc(var(--tile) + 32px);
        flex-direction: column;
        gap: 10px;
        padding: 16px;
        background: var(--color-page);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-chip);
        box-shadow: 0 8px 28px rgb(10 10 10 / 0.1);
        opacity: 0;
        transform: scale(0.97) translateX(-4px);
        transform-origin: left center;
        pointer-events: none;

        --dur: 200ms;
        --beat: 55ms;

        /* Exit faster than enter: the user has already moved on. */
        transition:
            opacity 120ms var(--ease-quint),
            transform 120ms var(--ease-quint);
    }

    .card-frame {
        flex: none;
    }

    /* No reveal of its own: anything directional on a photo reads as a
       progressive download rather than as intent. */
    .card-text {
        opacity: 0;
        transform: translateY(4px);
        transition:
            opacity 120ms var(--ease-quint),
            transform 120ms var(--ease-quint);
    }

    /* Second card onward in a sweep runs at about half the time. */
    :global([data-warm]) .reveal-card {
        --dur: 110ms;
        --beat: 25ms;
    }

    .reveal-row:is(:hover, :has(:focus-visible)) .reveal-card {
        opacity: 1;
        transform: scale(1) translateX(0);
        transition-duration: var(--dur);
    }

    .reveal-row:is(:hover, :has(:focus-visible)) .card-text {
        opacity: 1;
        transform: translateY(0);
        transition-duration: var(--dur);
        transition-delay: var(--beat);
    }

    /* Too little gutter to park it beside the column, so it goes under the row
       and turns horizontal, which keeps the image but halves the height. */
    :global([data-card="below"]) .reveal-card {
        left: 0;
        right: 0;
        width: auto;
        flex-direction: row;
        align-items: flex-start;
        transform: scale(0.99) translateY(-4px);
        transform-origin: top center;
    }

    :global([data-card="below"])
        .reveal-row:is(:hover, :has(:focus-visible))
        .reveal-card {
        transform: scale(1) translateY(0);
    }

    /* Nothing to hover, so the description is simply part of the row. */
    @media (hover: none) {
        .reveal-card {
            position: static;
            grid-column: 1 / -1;
            width: auto;
            padding: 6px 0 0;
            border: 0;
            background: none;
            box-shadow: none;
            opacity: 1;
            transform: none;
            pointer-events: auto;
        }

        .card-frame {
            display: none;
        }

        .card-text {
            opacity: 1;
            transform: none;
            color: var(--color-muted);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal-card,
        .reveal-row:is(:hover, :has(:focus-visible)) .reveal-card {
            transform: none;
            transition: opacity 120ms linear;
        }

        .card-text,
        .reveal-row:is(:hover, :has(:focus-visible)) .card-text {
            transform: none;
            transition: opacity 120ms linear;
            transition-delay: 0ms;
        }
    }
</style>

<script>
    const list = document.querySelector<HTMLElement>("[data-view-list]");

    if (list) {
        const GAP = 16;
        const tile =
            parseFloat(
                getComputedStyle(document.documentElement).getPropertyValue(
                    "--tile",
                ),
            ) || 232;
        // Card plus its 20px offset and a margin, measured against real free
        // space rather than a guessed breakpoint.
        const NEEDED = tile + 32 + 20 + GAP;

        let active: HTMLElement | null = null;
        let cool: ReturnType<typeof setTimeout>;

        function place(row: HTMLElement) {
            const card = row.querySelector<HTMLElement>(".reveal-card");
            if (!card) return;

            let rect = row.getBoundingClientRect();
            const beside = window.innerWidth - rect.right >= NEEDED;
            list!.dataset.card = beside ? "beside" : "below";

            // Re-read: the mode above changes the card's own size.
            rect = row.getBoundingClientRect();
            const want = beside ? rect.top - 8 : rect.bottom + 6;
            const max = window.innerHeight - card.offsetHeight - GAP;
            const top = Math.max(GAP, Math.min(want, max));
            card.style.setProperty("--card-top", `${top - rect.top}px`);
        }

        function open(row: HTMLElement) {
            active = row;
            clearTimeout(cool);
            place(row);
            list!.setAttribute("data-warm", "");
        }

        for (const row of list.querySelectorAll<HTMLElement>(".reveal-row")) {
            row.addEventListener("pointerenter", () => open(row));
            row.addEventListener("focusin", () => open(row));
        }

        list.addEventListener("pointerleave", () => {
            active = null;
            cool = setTimeout(() => list.removeAttribute("data-warm"), 400);
        });

        // place() reads layout, so coalesce to one call per paint.
        let queued = false;
        function reflow() {
            if (!active || queued) return;
            queued = true;
            requestAnimationFrame(() => {
                queued = false;
                if (active) place(active);
            });
        }

        addEventListener("scroll", reflow, { passive: true });
        addEventListener("resize", reflow, { passive: true });
    }
</script>
