---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";

interface Props {
    project: CollectionEntry<"projects">;
    img: ImageMetadata | undefined;
    index: number;
}

const {
    project: { data },
    img,
    index,
} = Astro.props;

const src = img ?? data.imageUrl;
---

<div
    class="enter -mx-3 grid min-h-[50px] grid-cols-[minmax(0,1fr)_24px] items-center gap-x-3 border-b border-hairline px-3 py-2.5 transition-colors duration-150 ease-quint hover:bg-ink/[0.03]"
    style={`--i: ${Math.min(index, 10) + 6}`}
>
    <div class="flex min-w-0 flex-col gap-0.5">
        <span class="truncate text-[14px] leading-[1.35]">
            <OptionalLink href={data.urls.project}>{data.name}</OptionalLink>
        </span>
        <span class="truncate text-[13px] leading-[1.35] text-muted">
            <Authors authors={data.authors} />
        </span>
    </div>

    <div class="size-6" aria-hidden="true">
        {
            src ? (
                <Image
                    class="dithered size-6"
                    src={src}
                    width={24}
                    height={24}
                    fit="cover"
                    alt=""
                />
            ) : (
                <div class="dither-field size-6" />
            )
        }
    </div>
</div>
