---
import { loadProjects } from "@lib/projects";
import ProjectRow from "@components/ProjectRow.astro";
import ProjectTile from "@components/ProjectTile.astro";
import ViewToggle from "@components/ViewToggle.astro";

const entries = await loadProjects();
---

<section class="flex flex-col gap-3" aria-labelledby="funded-heading">
    <div class="enter flex items-center justify-between gap-4" style="--i: 4">
        <h2 id="funded-heading" class="text-[14px] leading-none">
            recently funded
        </h2>
        <ViewToggle />
    </div>

    <div id="projects">
        <div data-view-list class="flex flex-col">
            {
                entries.map(({ project, img }, i) => (
                    <ProjectRow project={project} img={img} index={i} />
                ))
            }
        </div>

        <div
            data-view-grid
            class="grid justify-center gap-4 [grid-template-columns:repeat(auto-fill,312px)]"
        >
            {
                entries.map(({ project, img }, i) => (
                    <ProjectTile project={project} img={img} index={i} />
                ))
            }
        </div>
    </div>
</section>
