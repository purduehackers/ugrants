---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";

interface Props {
    project: CollectionEntry<"projects">;
    img: ImageMetadata | undefined;
    index: number;
}

const {
    project: { data },
    img,
    index,
} = Astro.props;

const src = img ?? data.imageUrl;
---

<figure
    class="enter flex w-[312px] max-w-full flex-col gap-2"
    style={`--i: ${Math.min(index, 10) + 6}`}
>
    <div class="w-[312px] max-w-full border border-hairline">
        {
            src ? (
                <Image
                    class="dithered w-[312px] max-w-full"
                    src={src}
                    width={312}
                    height={312}
                    fit="cover"
                    alt={data.name}
                />
            ) : (
                <div class="dither-field aspect-square w-[312px] max-w-full" />
            )
        }
    </div>

    <figcaption class="flex min-w-0 flex-col gap-0.5">
        <span class="truncate text-[14px] leading-[1.35]">
            <OptionalLink href={data.urls.project}>{data.name}</OptionalLink>
        </span>
        <span class="truncate text-[13px] leading-[1.35] text-muted">
            <Authors authors={data.authors} />
        </span>
    </figcaption>
</figure>
