---
// Publishes the current lightning-time colours as :root variables. The sign
// paints itself from them and links tint their underline from the same
// source, so there is one owner of the colour.
---

<svg
    class="h-full w-full"
    viewBox="0 0 300 300"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
>
    <!-- AI Generated -->
    <rect x="100" y="0" width="100" height="200" fill="var(--zap, currentColor)" />
    <rect x="200" y="100" width="100" height="200" fill="var(--spark, currentColor)" />
    <rect x="0" y="200" width="100" height="100" fill="var(--bolt, currentColor)" />
</svg>

<script>
    import { LightningTime } from "@purduehackers/time";

    const root = document.documentElement;

    // Deliberately off canonical. Most channels already sit on the sRGB edge,
    // so HSL cannot push them further; trading a little OKLCH lightness buys
    // real chroma instead.
    const L_MUL = 0.97;
    const C_MUL = 1.3;

    const toLinear = (v: number) =>
        v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
    const toGamma = (v: number) =>
        v <= 0.0031308 ? 12.92 * v : 1.055 * v ** (1 / 2.4) - 0.055;

    function saturate(hex: string) {
        const h = hex.replace("#", "");
        const [r, g, b] = [0, 2, 4].map((i) =>
            toLinear(parseInt(h.slice(i, i + 2), 16) / 255),
        );

        const l_ = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b); // prettier-ignore
        const m_ = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b); // prettier-ignore
        const s_ = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b); // prettier-ignore

        const L = (0.2104542553 * l_ + 0.793617785 * m_ - 0.0040720468 * s_) * L_MUL; // prettier-ignore
        const A = 1.9779984951 * l_ - 2.428592205 * m_ + 0.4505937099 * s_;
        const B = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.808675766 * s_;
        const C = Math.hypot(A, B) * C_MUL;
        const H = Math.atan2(B, A);

        const a = C * Math.cos(H);
        const b2 = C * Math.sin(H);
        const l = (L + 0.3963377774 * a + 0.2158037573 * b2) ** 3;
        const m = (L - 0.1055613458 * a - 0.0638541728 * b2) ** 3;
        const s = (L - 0.0894841775 * a - 1.291485548 * b2) ** 3;

        return (
            "#" +
            [
                4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
                -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
                -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
            ]
                .map((v) =>
                    Math.round(Math.min(1, Math.max(0, toGamma(v))) * 255)
                        .toString(16)
                        .padStart(2, "0"),
                )
                .join("")
        );
    }

    function tick() {
        const { boltColor, zapColor, sparkColor } = new LightningTime()
            .convertToLightning(new Date()).colors;
        root.style.setProperty("--bolt", saturate(boltColor));
        root.style.setProperty("--zap", saturate(zapColor));
        root.style.setProperty("--spark", saturate(sparkColor));
    }

    // Each channel advances about every 5.6 minutes, so a second is already
    // far finer than the data.
    tick();
    setInterval(tick, 1000);

    // Links take one channel each, cycling in document order, so the set of
    // them reads like the sign rather than one flat accent.
    const channels = ["--bolt", "--zap", "--spark"];
    document
        .querySelectorAll<HTMLElement>("a:not([data-plain])")
        .forEach((a, i) =>
            a.style.setProperty("--link", `var(${channels[i % 3]})`),
        );
</script>
