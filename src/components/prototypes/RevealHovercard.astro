---
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";
import type { LoadedProject } from "@lib/projects";

interface Props {
    entries: LoadedProject[];
}

const { entries } = Astro.props;
---

<div class="reveal-hovercard relative flex flex-col">
    {
        entries.map(({ project: { data }, img }) => {
            const src = img ?? data.imageUrl;
            return (
                <div
                    class="reveal-row -mx-3 grid min-h-[50px] grid-cols-[minmax(0,1fr)_24px] items-center gap-x-3 border-b border-hairline px-3 py-2.5 transition-colors duration-150 ease-quint hover:bg-ink/[0.03]"
                    tabindex="0"
                >
                    <div class="flex min-w-0 flex-col gap-0.5">
                        <span class="truncate text-[14px] leading-[1.35]">
                            <OptionalLink href={data.urls.project}>
                                {data.name}
                            </OptionalLink>
                        </span>
                        <span class="truncate text-[13px] leading-[1.35] text-muted">
                            <Authors authors={data.authors} />
                        </span>
                    </div>

                    <div class="size-6" aria-hidden="true">
                        {src ? (
                            <Image
                                class="dithered size-6"
                                src={src}
                                width={24}
                                height={24}
                                fit="cover"
                                alt=""
                            />
                        ) : (
                            <div class="dither-field size-6" />
                        )}
                    </div>

                    <div class="reveal-card" role="tooltip">
                        <div class="w-[288px] border border-hairline">
                            {src ? (
                                <Image
                                    class="dithered w-[288px]"
                                    src={src}
                                    width={288}
                                    height={288}
                                    fit="cover"
                                    alt=""
                                />
                            ) : (
                                <div class="dither-field aspect-square w-[288px]" />
                            )}
                        </div>
                        <p class="text-[13px] leading-[1.4] text-ink">
                            {data.description}
                        </p>
                    </div>
                </div>
            );
        })
    }
</div>

<style>
    .reveal-row {
        position: relative;
    }

    .reveal-card {
        position: absolute;
        /* Set by script to keep the whole card inside the viewport. */
        top: var(--card-top, -8px);
        left: calc(100% + 20px);
        z-index: 20;
        display: flex;
        width: 320px;
        flex-direction: column;
        gap: 10px;
        padding: 16px;
        background: var(--color-page);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-chip);
        box-shadow: 0 8px 28px rgb(10 10 10 / 0.1);
        opacity: 0;
        transform: scale(0.97) translateX(-4px);
        transform-origin: left center;
        pointer-events: none;
        transition:
            opacity 160ms var(--ease-quint),
            transform 160ms var(--ease-quint);
    }

    /* Once one card is open, the rest open instantly. The delay exists to
       stop accidental activation, not to slow a deliberate sweep. */
    :global([data-warm]) .reveal-card {
        transition-duration: 0ms;
    }

    @media (hover: hover) and (pointer: fine) {
        .reveal-row:hover .reveal-card {
            opacity: 1;
            transform: scale(1) translateX(0);
        }
    }

    .reveal-row:focus-visible .reveal-card {
        opacity: 1;
        transform: scale(1) translateX(0);
    }

    /* No gutter beside the column to park the card, so sit it over the column
       instead of letting it run off-screen sideways. */
    @media (max-width: 1320px) {
        .reveal-card {
            left: auto;
            right: 0;
            transform: scale(0.97) translateY(-4px);
            transform-origin: top right;
        }

        .reveal-row:hover .reveal-card,
        .reveal-row:focus-visible .reveal-card {
            transform: scale(1) translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal-card,
        .reveal-row:hover .reveal-card,
        .reveal-row:focus-visible .reveal-card {
            transition: opacity 120ms linear;
            transform: none;
        }
    }
</style>

<script>
    const wrap = document.querySelector<HTMLElement>(".reveal-hovercard");

    if (wrap) {
        const GAP = 16;
        const rows = [...wrap.querySelectorAll<HTMLElement>(".reveal-row")];
        let active: HTMLElement | null = null;
        let cool: ReturnType<typeof setTimeout>;

        // Cards are taller than a row and the last ones would hang off the
        // bottom, so clamp each into the viewport rather than flipping it.
        function place(row: HTMLElement) {
            const card = row.querySelector<HTMLElement>(".reveal-card");
            if (!card) return;
            const rect = row.getBoundingClientRect();
            const max = window.innerHeight - card.offsetHeight - GAP;
            const top = Math.max(GAP, Math.min(rect.top - 8, max));
            card.style.setProperty("--card-top", `${top - rect.top}px`);
        }

        function open(row: HTMLElement) {
            active = row;
            clearTimeout(cool);
            wrap!.setAttribute("data-warm", "");
            place(row);
        }

        for (const row of rows) {
            row.addEventListener("pointerenter", () => open(row));
            row.addEventListener("focus", () => open(row));
        }

        wrap.addEventListener("pointerleave", () => {
            active = null;
            cool = setTimeout(() => wrap.removeAttribute("data-warm"), 400);
        });

        const reflow = () => active && place(active);
        addEventListener("scroll", reflow, { passive: true });
        addEventListener("resize", reflow);
    }
</script>
