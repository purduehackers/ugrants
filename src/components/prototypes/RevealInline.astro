---
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";
import type { LoadedProject } from "@lib/projects";

interface Props {
    entries: LoadedProject[];
}

const { entries } = Astro.props;
---

<div class="reveal-inline flex flex-col">
    {
        entries.map(({ project: { data }, img }) => {
            const src = img ?? data.imageUrl;
            return (
                <div
                    class="reveal-row -mx-3 grid min-h-[50px] grid-cols-[minmax(0,1fr)_24px] items-center gap-x-3 border-b border-hairline px-3 py-2.5 transition-colors duration-150 ease-quint hover:bg-ink/[0.03] sm:grid-cols-[minmax(0,1fr)_300px_24px]"
                    tabindex="0"
                >
                    <div class="flex min-w-0 flex-col gap-0.5">
                        <span class="truncate text-[14px] leading-[1.35]">
                            <OptionalLink href={data.urls.project}>
                                {data.name}
                            </OptionalLink>
                        </span>
                        <span class="truncate text-[13px] leading-[1.35] text-muted">
                            <Authors authors={data.authors} />
                        </span>
                    </div>

                    <p class="inline-desc hidden sm:block">
                        {data.description}
                    </p>

                    <div class="size-6" aria-hidden="true">
                        {src ? (
                            <Image
                                class="dithered size-6"
                                src={src}
                                width={24}
                                height={24}
                                fit="cover"
                                alt=""
                            />
                        ) : (
                            <div class="dither-field size-6" />
                        )}
                    </div>
                </div>
            );
        })
    }
</div>

<style>
    /* Fades into the space the ordinals used to occupy, so the row never
       changes size and the list never reflows. */
    .inline-desc {
        margin: 0;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        font-size: 12px;
        line-height: 1.35;
        color: var(--color-muted);
        opacity: 0;
        filter: blur(3px);
        transition:
            opacity 140ms var(--ease-quint),
            filter 140ms var(--ease-quint);
    }

    @media (hover: hover) and (pointer: fine) {
        .reveal-row:hover .inline-desc {
            opacity: 1;
            filter: blur(0);
        }
    }

    .reveal-row:focus-visible .inline-desc {
        opacity: 1;
        filter: blur(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .inline-desc {
            transition-duration: 80ms;
            filter: none !important;
        }
    }
</style>
