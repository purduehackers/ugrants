---
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";
import type { LoadedProject } from "@lib/projects";

interface Props {
    entries: LoadedProject[];
}

const { entries } = Astro.props;
---

<div class="reveal-inline flex flex-col">
    {
        entries.map(({ project: { data }, img }, i) => {
            const src = img ?? data.imageUrl;
            return (
                <div
                    class="reveal-row -mx-3 grid min-h-[50px] grid-cols-[minmax(0,1fr)_304px_56px] items-center gap-x-3 border-b border-hairline px-3 py-2.5 transition-colors duration-150 ease-quint hover:bg-ink/[0.03]"
                    tabindex="0"
                >
                    <div class="flex min-w-0 flex-col gap-0.5">
                        <span class="truncate text-[14px] leading-[1.35] font-semibold">
                            <OptionalLink href={data.urls.project}>
                                {data.name}
                            </OptionalLink>
                        </span>
                        <span class="truncate text-[13px] leading-[1.35] text-muted">
                            <Authors authors={data.authors} />
                        </span>
                    </div>

                    <div class="swap-slot h-8 w-[304px]">
                        <div class="swap-strip" aria-hidden="true">
                            {src ? (
                                <Image
                                    class="dithered h-8 w-[304px]"
                                    src={src}
                                    width={304}
                                    height={32}
                                    fit="cover"
                                    alt=""
                                />
                            ) : (
                                <div class="dither-field h-8 w-[304px]" />
                            )}
                        </div>
                        <p class="swap-desc">{data.description}</p>
                    </div>

                    <span class="text-right font-mono text-[13px] tabular-nums text-muted">
                        {String(i + 1).padStart(2, "0")}
                    </span>
                </div>
            );
        })
    }
</div>

<style>
    .swap-slot {
        position: relative;
    }

    .swap-strip,
    .swap-desc {
        position: absolute;
        inset: 0;
        transition:
            opacity 140ms var(--ease-quint),
            filter 140ms var(--ease-quint);
    }

    .swap-desc {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        margin: 0;
        font-size: 12px;
        line-height: 1.35;
        color: var(--color-muted);
        opacity: 0;
        filter: blur(3px);
    }

    @media (hover: hover) and (pointer: fine) {
        .reveal-row:hover .swap-strip {
            opacity: 0;
            filter: blur(3px);
        }
        .reveal-row:hover .swap-desc {
            opacity: 1;
            filter: blur(0);
        }
    }

    .reveal-row:focus-visible .swap-strip {
        opacity: 0;
        filter: blur(3px);
    }

    .reveal-row:focus-visible .swap-desc {
        opacity: 1;
        filter: blur(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .swap-strip,
        .swap-desc {
            transition-duration: 80ms;
            filter: none !important;
        }
    }
</style>
