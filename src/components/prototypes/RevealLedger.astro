---
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";
import type { LoadedProject } from "@lib/projects";

interface Props {
    entries: LoadedProject[];
}

const { entries } = Astro.props;
---

<div class="reveal-ledger flex flex-col">
    <div class="flex flex-col">
        {
            entries.map(({ project: { data }, img }, i) => {
                const src = img ?? data.imageUrl;
                return (
                    <div
                        class="reveal-row -mx-3 grid min-h-[50px] grid-cols-[minmax(0,1fr)_304px_56px] items-center gap-x-3 border-b border-hairline px-3 py-2.5 transition-colors duration-150 ease-quint hover:bg-ink/[0.03]"
                        tabindex="0"
                        data-description={data.description}
                    >
                        <div class="flex min-w-0 flex-col gap-0.5">
                            <span class="truncate text-[14px] leading-[1.35]">
                                <OptionalLink href={data.urls.project}>
                                    {data.name}
                                </OptionalLink>
                            </span>
                            <span class="truncate text-[13px] leading-[1.35] text-muted">
                                <Authors authors={data.authors} />
                            </span>
                        </div>

                        <div class="h-8 w-[304px]" aria-hidden="true">
                            {src ? (
                                <Image
                                    class="dithered h-8 w-[304px]"
                                    src={src}
                                    width={304}
                                    height={32}
                                    fit="cover"
                                    alt=""
                                />
                            ) : (
                                <div class="dither-field h-8 w-[304px]" />
                            )}
                        </div>

                        <span class="text-right font-mono text-[13px] tabular-nums text-muted">
                            {String(i + 1).padStart(2, "0")}
                        </span>
                    </div>
                );
            })
        }
    </div>

    <div class="ledger-bar">
        <div class="rule-dither w-full"></div>
        <p class="ledger-text" aria-live="polite">
            hover a project to read its description
        </p>
    </div>
</div>

<style>
    .ledger-bar {
        position: sticky;
        bottom: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding-top: 10px;
        padding-bottom: 16px;
        background: var(--color-page);
    }

    .ledger-text {
        /* Three lines reserved so the bar never changes height and the list
           above it never reflows. */
        min-height: calc(3 * 1.4 * 13px);
        font-size: 13px;
        line-height: 1.4;
        color: var(--color-muted);
        transition:
            opacity 110ms var(--ease-quint),
            filter 110ms var(--ease-quint);
    }

    .ledger-text[data-swap] {
        opacity: 0;
        filter: blur(3px);
    }

    @media (prefers-reduced-motion: reduce) {
        .ledger-text,
        .ledger-text[data-swap] {
            transition: none;
            opacity: 1;
            filter: none;
        }
    }
</style>

<script>
    const wrap = document.querySelector<HTMLElement>(".reveal-ledger");
    const out = wrap?.querySelector<HTMLElement>(".ledger-text");

    if (wrap && out) {
        const idle = "hover a project to read its description";
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
        let timer: ReturnType<typeof setTimeout>;
        let showing = idle;

        function show(text: string) {
            if (text === showing) return;
            showing = text;

            if (reduced.matches) {
                out!.textContent = text;
                return;
            }

            out!.dataset.swap = "";
            clearTimeout(timer);
            timer = setTimeout(() => {
                out!.textContent = text;
                requestAnimationFrame(() => out!.removeAttribute("data-swap"));
            }, 110);
        }

        for (const row of wrap.querySelectorAll<HTMLElement>(".reveal-row")) {
            const text = row.dataset.description ?? idle;
            row.addEventListener("pointerenter", () => show(text));
            row.addEventListener("focus", () => show(text));
        }

        wrap.addEventListener("pointerleave", () => show(idle));
    }
</script>
