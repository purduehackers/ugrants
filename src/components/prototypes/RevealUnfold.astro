---
import { Image } from "astro:assets";
import Authors from "@components/Authors.astro";
import OptionalLink from "@components/OptionalLink.astro";
import type { LoadedProject } from "@lib/projects";

interface Props {
    entries: LoadedProject[];
}

const { entries } = Astro.props;
---

<div class="reveal-unfold flex flex-col">
    {
        entries.map(({ project: { data }, img }) => {
            const src = img ?? data.imageUrl;
            return (
                <div
                    class="reveal-row -mx-3 border-b border-hairline px-3 py-2.5 transition-colors duration-150 ease-quint hover:bg-ink/[0.03]"
                    tabindex="0"
                >
                    <div class="grid min-h-[50px] grid-cols-[minmax(0,1fr)_24px] items-center gap-x-3">
                        <div class="flex min-w-0 flex-col gap-0.5">
                            <span class="truncate text-[14px] leading-[1.35]">
                                <OptionalLink href={data.urls.project}>
                                    {data.name}
                                </OptionalLink>
                            </span>
                            <span class="truncate text-[13px] leading-[1.35] text-muted">
                                <Authors authors={data.authors} />
                            </span>
                        </div>

                        <div class="size-6" aria-hidden="true">
                            {src ? (
                                <Image
                                    class="dithered size-6"
                                    src={src}
                                    width={24}
                                    height={24}
                                    fit="cover"
                                    alt=""
                                />
                            ) : (
                                <div class="dither-field size-6" />
                            )}
                        </div>
                    </div>

                    <div class="unfold">
                        <p class="unfold-inner">{data.description}</p>
                    </div>
                </div>
            );
        })
    }
</div>

<style>
    /* 0fr -> 1fr is the one height animation cheap enough to use here;
       max-height would need a magic number per row. */
    .unfold {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 200ms var(--ease-quint);
    }

    .unfold-inner {
        overflow: hidden;
        min-height: 0;
        margin: 0;
        font-size: 13px;
        line-height: 1.4;
        color: var(--color-muted);
        opacity: 0;
        transition: opacity 200ms var(--ease-quint);
    }

    @media (hover: hover) and (pointer: fine) {
        .reveal-row:hover .unfold {
            grid-template-rows: 1fr;
        }
        .reveal-row:hover .unfold-inner {
            padding-top: 8px;
            opacity: 1;
        }
    }

    .reveal-row:focus-visible .unfold {
        grid-template-rows: 1fr;
    }

    .reveal-row:focus-visible .unfold-inner {
        padding-top: 8px;
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .unfold,
        .unfold-inner {
            transition: none;
        }
    }
</style>
