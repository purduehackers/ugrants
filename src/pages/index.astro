---
import Layout from "@layouts/Layout.astro";
import Entry from "@components/Entry.astro";
import ProjectShowcase from "@components/ProjectShowcase.astro";
---

<Layout>
    <main class="flex min-h-dvh w-full justify-center">
        <!-- One column, page scrolls. No viewport lock, no inner scroll pane. -->
        <article class="measure flex flex-col gap-9 pt-20 pb-24 max-sm:pt-10 max-sm:pb-16">
            <Entry />
            <ProjectShowcase />
        </article>
    </main>
</Layout>
