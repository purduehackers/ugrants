---
import Layout from "@layouts/Layout.astro";
import Entry from "@components/Entry.astro";
import ProjectShowcase from "@components/ProjectShowcase.astro";
---

<Layout>
    <main class="flex min-h-dvh w-full justify-center">
        <!-- One column, page scrolls. No viewport lock, no inner scroll pane. -->
        <article class="measure flex flex-col gap-9 pt-20 pb-24 max-sm:pt-10 max-sm:pb-16">
            <Entry />
            <ProjectShowcase />
            <section class="flex flex-col gap-4 border-t border-hairline pt-6">
                <h2 class="font-medium">where can i get support for a student project?</h2>
                <p>
                    µgrants offers up to $1,000 to kickstart student projects and
                    artworks at Purdue. Follow the intake link above for current
                    applications. You can also meet collaborators at
                    <a class="underline" href="https://www.purduehackers.com/hack-night">Hack Night</a>
                    and share your progress on
                    <a class="underline" href="https://ships.purduehackers.com/">Ships</a>.
                </p>
                <p>
                    See what people made for
                    <a class="underline" href="https://burst.purduehackers.com/">BURST</a>
                    and <a class="underline" href="https://spill.purduehackers.com/">spill</a>,
                    or hear their ideas at
                    <a class="underline" href="https://bento.purduehackers.com/">BENTO</a>.
                </p>
                <p class="text-muted text-xs">program details checked <time datetime="2026-10-20">october 20, 2026</time>.</p>
            </section>
        </article>
    </main>
</Layout>
